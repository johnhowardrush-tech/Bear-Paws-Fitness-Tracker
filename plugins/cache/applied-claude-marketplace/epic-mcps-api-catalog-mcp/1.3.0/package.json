{
  "name": "@appliedsystems/epic-api-catalog-mcp",
  "version": "1.0.0",
  "description": "MCP server for browsing, searching, and testing Epic API miniservice endpoints from OpenAPI specs",
  "type": "module",
  "bin": {
    "epic-api-catalog-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --banner:js=\"#!/usr/bin/env node\"",
    "prepare": "npm run build",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

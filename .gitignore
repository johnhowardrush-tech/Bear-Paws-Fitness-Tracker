# === KEEP THESE (they're the actual app) ===
# .github/workflows/deploy.yml - GitHub Actions deploy
# .gitignore - This file
# .gitlab-ci.yml - GitLab deploy (optional)
# config.js - Firebase config (public, by design)
# index.html - Main app
# README.md - Documentation
# css/ - Styles
# js/ - JavaScript
# data/ - Seed data
